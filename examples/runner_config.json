{
  "runners": {
    "agy": {
      "command_template": ["agy", "--model", "gemini-3.6-flash-medium", "--effort", "medium", "--mode", "accept-edits", "--print-timeout", "300s", "--print", "Follow the task instructions supplied on stdin."],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"low\"", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "--skip-git-repo-check", "-"]
        }
      }
    },
    "codex": {
      "command_template": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "-"],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "prototype_planning": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-sol", "--dangerously-bypass-approvals-and-sandbox", "-"]
        },
        "plan_comprehension_check": {
          "command_template": ["copilot", "--model", "gpt-5.6-luna", "--effort", "low", "--allow-all-tools", "--disable-builtin-mcps", "--silent"]
        },
        "implementation": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"max\"", "--dangerously-bypass-approvals-and-sandbox", "-"]
        },
        "review_fix_loop": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-sol", "--dangerously-bypass-approvals-and-sandbox", "-"]
        }
      }
    },
    "copilot": {
      "command_template": ["copilot", "--allow-all-tools", "--silent"],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"low\"", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "--skip-git-repo-check", "-"]
        }
      }
    },
    "opencode_ollama": {
      "command_template": ["kelpie-opencode", "run", "--pure", "--agent", "kelpie-artifact"],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"low\"", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "--skip-git-repo-check", "-"]
        },
        "implementation": {
          "command_template": ["kelpie-opencode", "run", "--pure", "--auto", "--agent", "kelpie-workspace"]
        },
        "review_fix_loop": {
          "command_template": ["kelpie-opencode", "run", "--pure", "--auto", "--agent", "kelpie-workspace"]
        }
      }
    },
    "custom_file_prompt": {
      "command_template": ["bash", "-lc", "my-agent --prompt-file {prompt_file}"],
      "prompt_mode": "file",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"low\"", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "--skip-git-repo-check", "-"],
          "prompt_mode": "stdin"
        }
      }
    },
    "hybrid_cli": {
      "command_template": ["agy", "--model", "gemini-3.6-flash-medium", "--effort", "medium", "--mode", "accept-edits", "--print-timeout", "300s", "--print", "Follow the task instructions supplied on stdin."],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "solution_design": {
          "prompt_file": "prompts/04_solution_design.md",
          "skill_file": "skills/solution-design/SKILL.md"
        },
        "plan_comprehension_check": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"low\"", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "--skip-git-repo-check", "-"]
        },
        "implementation": {
          "command_template": ["codex", "exec", "--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"max\"", "--dangerously-bypass-approvals-and-sandbox", "-"],
          "prompt_mode": "stdin"
        },
        "review_fix_loop": {
          "command_template": ["copilot", "--allow-all-tools", "--silent"]
        }
      }
    }
  }
}
