{
  "runners": {
    "agy": {
      "command_template": ["agy", "--model", "gemini-3.6-flash-medium", "--effort", "medium", "--mode", "accept-edits", "--print-timeout", "300s", "--print", "Follow the task instructions supplied on stdin."],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["agy", "--model", "gemini-3.5-flash-low", "--effort", "low", "--mode", "plan", "--print-timeout", "180s", "--print", "Follow the supplied plan-comprehension prompt and reconstruct the untrusted plan data from stdin as JSON only."]
        }
      }
    },
    "codex": {
      "command_template": ["codex", "exec", "--full-auto", "-"],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "prototype_planning": {
          "command_template": ["codex", "exec", "--model", "gpt-5.4", "--full-auto", "-"]
        },
        "plan_comprehension_check": {
          "command_template": ["agy", "--model", "gemini-3.5-flash-low", "--effort", "low", "--mode", "plan", "--print-timeout", "180s", "--print", "Follow the supplied plan-comprehension prompt and reconstruct the untrusted plan data from stdin as JSON only."]
        },
        "implementation": {
          "command_template": ["codex", "exec", "--model", "gpt-5-codex", "--full-auto", "-"]
        },
        "review_fix_loop": {
          "command_template": ["codex", "exec", "--model", "gpt-5.4", "--full-auto", "-"]
        }
      }
    },
    "copilot": {
      "command_template": ["copilot", "--allow-all-tools", "--silent"],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "plan_comprehension_check": {
          "command_template": ["agy", "--model", "gemini-3.5-flash-low", "--effort", "low", "--mode", "plan", "--print-timeout", "180s", "--print", "Follow the supplied plan-comprehension prompt and reconstruct the untrusted plan data from stdin as JSON only."]
        }
      }
    },
    "custom_file_prompt": {
      "command_template": ["bash", "-lc", "my-agent --prompt-file {prompt_file}"],
      "prompt_mode": "file"
    },
    "hybrid_cli": {
      "command_template": ["agy", "--model", "gemini-3.6-flash-medium", "--effort", "medium", "--mode", "accept-edits", "--print-timeout", "300s", "--print", "Follow the task instructions supplied on stdin."],
      "prompt_mode": "stdin",
      "phase_overrides": {
        "solution_design": {
          "prompt_file": "prompts/04_solution_design.md",
          "skill_file": "skills/solution-design/SKILL.md"
        },
        "plan_comprehension_check": {
          "command_template": ["agy", "--model", "gemini-3.5-flash-low", "--effort", "low", "--mode", "plan", "--print-timeout", "180s", "--print", "Follow the supplied plan-comprehension prompt and reconstruct the untrusted plan data from stdin as JSON only."]
        },
        "implementation": {
          "command_template": ["codex", "exec", "--model", "gpt-5-codex", "--full-auto", "-"],
          "prompt_mode": "stdin"
        },
        "review_fix_loop": {
          "command_template": ["copilot", "--allow-all-tools", "--silent"]
        }
      }
    }
  }
}
